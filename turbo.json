{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "CI",
    "CYBERSTRIKE_DISABLE_SHARE",
    "CYBERSTRIKE_BUILD_OS"
  ],
  "globalPassThroughEnv": [
    "CI",
    "CYBERSTRIKE_DISABLE_SHARE",
    "CYBERSTRIKE_BUILD_OS"
  ],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "cyberstrike#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@cyberstrike-io/app#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@cyberstrike-io/hackbrowser#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@cyberstrike-io/console-core#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
